{
  "name": "tinyengine-three-persistent-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:serve:mock\" \"npm:serve:frontend\"",
    "serve:frontend": "vite --host 127.0.0.1 --port 8090 --strictPort",
    "serve:mock": "node node_modules/@opentiny/tiny-engine-mock/dist/app.js",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=10240 vite build"
  },
  "dependencies": {
    "@opentiny/tiny-engine": "2.11.0",
    "@opentiny/tiny-engine-common": "2.11.0",
    "@opentiny/tiny-engine-meta-register": "2.11.0",
    "@opentiny/tiny-engine-utils": "2.11.0",
    "@opentiny/vue": "3.20.0",
    "@opentiny/vue-design-smb": "3.20.0",
    "@opentiny/vue-icon": "3.20.0",
    "@opentiny/vue-locale": "3.20.0",
    "@opentiny/vue-renderless": "3.20.0",
    "@opentiny/vue-theme": "3.20.0",
    "@vueuse/core": "9.13.0",
    "vue": "3.5.13",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@opentiny/tiny-engine-mock": "2.11.0",
    "@opentiny/tiny-engine-vite-config": "2.11.0",
    "@vitejs/plugin-vue": "5.1.4",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "vite": "5.4.19"
  }
}
